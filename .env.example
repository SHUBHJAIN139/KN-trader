# ════════════════════════════════════════════════════════════════
# KN Smart TP SL Trader — Environment Variables (v4.0)
# ════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   copy .env.example .env
# NEVER commit .env to git!

# ─── Telegram Bot ───────────────────────────────────────────────
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Chat ID of your channel/group (can be negative or starting with @)
TELEGRAM_CHAT_ID=your-telegram-chat-id

# ─── Google Sheets ──────────────────────────────────────────────
# Path to your service account JSON file (or raw credentials JSON string for GHA)
GOOGLE_CREDENTIALS_PATH=credentials/service-account.json
# Title of the spreadsheet as shown in the top browser bar
GOOGLE_SHEET_NAME=KN Trader Signals

# ─── Twelve Data API (Fallback / Optional) ──────────────────────
# TWELVE_DATA_API_KEY=your-twelve-data-api-key

# ─── Chartink Screener ──────────────────────────────────────────
# Default screener URL (stocks are fetched from here daily)
CHARTINK_SCREENER_URL=https://chartink.com/screener/trading-view-11042052
# Optional hardcoded scan clause (skip extraction if set)
# CHARTINK_SCAN_CLAUSE=

# ─── Indicator Settings (match Pine Script defaults) ────────────
EMA_FAST=5
EMA_SLOW=13
ATR_PERIOD=14
SL_ATR_MULT=1.5
RR1=1.0
RR2=2.0
RR3=3.0

# ─── Volume Filtering (New in v4.0) ─────────────────────────────
# Top N stocks sorted by volume to fetch from Chartink screener results
TOP_N=50
# Minimum ratio: signal_volume >= this * 20-bar rolling average volume
MIN_VOL_RATIO=1.5
